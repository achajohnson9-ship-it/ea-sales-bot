#!/usr/bin/env python3
"""
EA Sales Bot - a friendly Telegram bot that chats with buyers and sells your MT5 EA.

No extra packages needed: uses only Python's standard library.

Run:   python3 bot.py
Edit:  config.json  (token, admin id, product text, prices, answers, payment details)
Data:  data.json    (created automatically: users, orders, licenses)
"""

import html
import json
import os
import random
import re
import string
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATH = os.path.join(HERE, "config.json")
DATA_PATH = os.path.join(HERE, "data.json")


# ================================================================ storage

def load_json(path, default):
    if not os.path.exists(path):
        return default
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_data():
    tmp = DATA_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(DATA, f, indent=2)
    os.replace(tmp, DATA_PATH)


CFG = load_json(CONFIG_PATH, None)
if CFG is None:
    sys.exit("config.json not found next to bot.py")

DATA = load_json(DATA_PATH, {})
DATA.setdefault("users", {})       # user_id -> {name, username, joined}
DATA.setdefault("orders", {})      # order_id -> {...}
DATA.setdefault("licenses", [])    # [{order_id, user_id, account, plan, date}]
DATA.setdefault("relay", {})       # admin message id -> buyer user id (for live chat)
DATA.setdefault("ea_file_id", None)
DATA.setdefault("offset", 0)

STATE = {}  # user_id -> {"step": ..., ...}   what we're waiting for from each person

API = "https://api.telegram.org/bot{}/{}".format(CFG["bot_token"], "{}")
P = CFG["product"]
ADMIN = int(CFG.get("admin_chat_id") or 0)


# ================================================================ telegram api

def api(method, **params):
    body = json.dumps({k: v for k, v in params.items() if v is not None}).encode()
    req = urllib.request.Request(
        API.format(method), data=body, headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=70) as r:
            res = json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        res = json.loads(e.read().decode() or "{}")
    except Exception as e:
        print(f"[api] {method} network error: {e}", file=sys.stderr)
        return None
    if not res.get("ok"):
        print(f"[api] {method} failed: {res.get('description')}", file=sys.stderr)
        return None
    return res.get("result")


# The buttons that always sit at the bottom of the chat
MAIN_KEYBOARD = {
    "keyboard": [
        [{"text": "🛒 Buy"}, {"text": "💰 Prices"}],
        [{"text": "📊 Results"}, {"text": "❓ How it works"}],
        [{"text": "💬 Talk to us"}, {"text": "📦 My order"}],
    ],
    "resize_keyboard": True,
    "is_persistent": True,
}


def say(chat_id, text, buttons=None, typing=True):
    """Send a message the way a person would: show 'typing...' first, then reply."""
    if typing:
        api("sendChatAction", chat_id=chat_id, action="typing")
        time.sleep(min(1.5, 0.4 + len(text) / 600))
    markup = {"inline_keyboard": buttons} if buttons else MAIN_KEYBOARD
    return api("sendMessage", chat_id=chat_id, text=text, parse_mode="HTML",
               disable_web_page_preview=True, reply_markup=markup)


def edit(chat_id, message_id, text, buttons=None):
    r = api("editMessageText", chat_id=chat_id, message_id=message_id, text=text,
            parse_mode="HTML", disable_web_page_preview=True,
            reply_markup={"inline_keyboard": buttons} if buttons else None)
    if r is None:
        say(chat_id, text, buttons, typing=False)


def btn(text, data):
    return {"text": text, "callback_data": data}


# ================================================================ text helpers

def e(s):
    return html.escape(str(s))


def plan_by_id(pid):
    return next((p for p in CFG["plans"] if p["id"] == pid), None)


def price_list():
    return "\n".join(
        f"• <b>{e(p['label'])}</b>: {e(p['price'])} "
        f"({p['accounts']} MT5 account{'s' if p['accounts'] > 1 else ''})"
        for p in CFG["plans"]
    )


def fill(text, name=""):
    """Swap {placeholders} in answers for real values from config.json."""
    values = {
        "{price_list}": price_list(),
        "{results_url}": e(P["results_url"]),
        "{description}": e(P["description"]),
        "{min_balance}": e(P["min_balance"]),
        "{setup_guide}": e(CFG["setup_guide"]),
        "{product}": e(P["name"]),
        "{support}": e(CFG["support_username"]),
        "{name}": e(name),
    }
    for k, v in values.items():
        text = text.replace(k, v)
    return text


def matches(text, keywords):
    t = text.lower()
    for kw in keywords:
        kw = kw.lower()
        if " " in kw:
            if kw in t:
                return True
        elif re.search(r"\b" + re.escape(kw) + r"\b", t):
            return True
    return False


def new_order_id():
    while True:
        oid = "EA-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
        if oid not in DATA["orders"]:
            return oid


def now_ts():
    return int(time.time())


def now_str():
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def latest_order(uid):
    mine = [(oid, o) for oid, o in DATA["orders"].items() if o["user_id"] == uid]
    return max(mine, key=lambda x: x[1]["created_ts"]) if mine else (None, None)


NEXT_STEP = [[btn("🛒 Buy now", "buy"), btn("💬 Ask a question", "talk")]]


# ================================================================ conversation pieces

def welcome(chat_id, first_name):
    say(chat_id,
        f"Hi {e(first_name)} 👋\n\n"
        f"I'm the <b>{e(P['name'])}</b> assistant. {e(P['name'])} is "
        f"{e(P['tagline'])}.\n\n"
        "You can tap the buttons at the bottom, or just type your question the "
        "way you'd ask a friend, like <i>\"how much is it?\"</i> or "
        "<i>\"does it really work?\"</i>")
    say(chat_id, "Quick question so I can explain things better: "
                 "have you used a trading robot (EA) before?",
        [[btn("🙋 No, I'm new", "exp:new"), btn("👍 Yes, I have", "exp:pro")]])


def explain_for_beginner(chat_id):
    say(chat_id,
        "No problem, I'll keep it simple 🙂\n\n"
        "A <b>trading robot (EA)</b> is a program that runs inside MetaTrader 5 "
        "and opens and closes trades for you, so you don't have to watch charts "
        "all day.\n\n"
        f"<b>What {e(P['name'])} does:</b> {e(P['description'])}")
    say(chat_id, "What would you like to see next?",
        [[btn("📊 Live results", "results"), btn("💰 Prices", "prices")],
         [btn("🛠 How do I set it up?", "setup")]])


def explain_for_pro(chat_id):
    feats = "\n".join(f"✅ {e(f)}" for f in P["features"])
    say(chat_id,
        f"Great, then you'll feel at home 💪\n\n<b>{e(P['name'])} at a glance</b>\n{feats}\n\n"
        f"🖥 {e(P['platform'])}   💼 Recommended balance: {e(P['min_balance'])}")
    say(chat_id, "Want to see it in action?",
        [[btn("📊 Live results", "results"), btn("💰 Prices", "prices")]])


def show_how_it_works(chat_id):
    feats = "\n".join(f"✅ {e(f)}" for f in P["features"])
    say(chat_id, f"<b>How {e(P['name'])} works</b>\n\n{e(P['description'])}\n\n{feats}")
    say(chat_id, "Anything else you'd like to know?", NEXT_STEP)


def show_prices(chat_id):
    say(chat_id, f"<b>💰 Prices</b>\n\n{price_list()}\n\n"
                 "Your copy is linked to your MT5 account number.\n\n"
                 f"<i>{e(CFG['disclaimer'])}</i>", NEXT_STEP)


def show_results(chat_id):
    say(chat_id, "<b>📊 Live results</b>\n\nYou can check the real account here:\n"
                 f"{e(P['results_url'])}\n\n<i>{e(CFG['disclaimer'])}</i>", NEXT_STEP)


def show_setup(chat_id):
    say(chat_id, f"<b>🛠 Setting it up (about 5 minutes)</b>\n\n{e(CFG['setup_guide'])}\n\n"
                 "After you buy, I'll send you the file along with these steps.", NEXT_STEP)


def show_my_order(chat_id, uid):
    oid, o = latest_order(uid)
    if not o:
        say(chat_id, "You don't have an order yet. Tap 🛒 Buy whenever you're ready 🙂")
        return
    plan = plan_by_id(o["plan"])
    status_words = {
        "awaiting_payment": "⏳ Waiting for your payment. Once you've paid, just send the receipt here.",
        "pending_review": "🔎 We got your receipt and we're checking it now. You'll get the EA here soon.",
        "approved": "✅ Paid and delivered. Check further up this chat for your file.",
        "rejected": "❌ We couldn't confirm this payment. Tap 💬 Talk to us and we'll help.",
    }
    say(chat_id, f"<b>📦 Your order</b>\nOrder ID: <code>{oid}</code>\n"
                 f"Plan: {e(plan['label'] if plan else o['plan'])} ({e(o['price'])})\n"
                 f"MT5 account: <code>{o['account']}</code>\n\n{status_words[o['status']]}")


def start_talk(chat_id, uid):
    STATE[uid] = {"step": "talk"}
    say(chat_id, "Sure 🙂 Type your message and I'll pass it straight to our team. "
                 "They'll reply right here in this chat.")


def start_buy(chat_id, uid):
    STATE.pop(uid, None)
    rows = [[btn(f"{p['label']} - {p['price']}", f"plan:{p['id']}")] for p in CFG["plans"]]
    say(chat_id, "Great choice! 🎉 Buying takes 3 quick steps.\n\n"
                 "<b>Step 1 of 3:</b> Which plan would you like?", rows)


def ask_account(chat_id, uid, plan):
    STATE[uid] = {"step": "account", "plan": plan["id"]}
    say(chat_id, f"👍 <b>{e(plan['label'])}</b> ({e(plan['price'])}).\n\n"
                 "<b>Step 2 of 3:</b> Type the <b>MT5 account number</b> you'll use "
                 "the robot on.\n\n"
                 "<i>Where to find it: in MT5, it's the number at the top of the "
                 "Navigator panel, or in the email your broker sent when you opened "
                 "the account.</i>")


def confirm_account(chat_id, uid, acct):
    st = STATE[uid]
    st.update(step="confirm", account=acct)
    plan = plan_by_id(st["plan"])
    say(chat_id, f"Let me check I've got this right:\n\n"
                 f"Plan: <b>{e(plan['label'])}</b> ({e(plan['price'])})\n"
                 f"MT5 account: <b>{acct}</b>\n\nIs that correct?",
        [[btn("✅ Yes, continue", "confirm"), btn("✏️ Change it", f"plan:{plan['id']}")]])


def ask_payment(chat_id, user):
    uid = user["id"]
    st = STATE[uid]
    plan = plan_by_id(st["plan"])
    oid = new_order_id()
    DATA["orders"][oid] = {
        "user_id": uid, "name": user.get("first_name", ""),
        "username": user.get("username", ""), "plan": plan["id"],
        "price": plan["price"], "account": st["account"],
        "status": "awaiting_payment", "created": now_str(), "created_ts": now_ts(),
        "reminded": False,
    }
    save_data()
    STATE[uid] = {"step": "proof", "order_id": oid}
    say(chat_id, f"<b>Step 3 of 3:</b> Payment 💳\n\n"
                 f"Your Order ID is <code>{oid}</code>. Please write it in the payment "
                 f"note.\n\nAmount: <b>{e(plan['price'])}</b>\n\n"
                 f"{CFG['payment_instructions']}")
    say(chat_id, "When you've paid, just send me a <b>screenshot of the receipt</b> "
                 "(or the transaction hash for USDT) right here. I'll take it from there 🙂")


def receive_proof(m, uid, oid):
    order = DATA["orders"].get(oid)
    if not order:
        return
    order["status"] = "pending_review"
    save_data()
    STATE.pop(uid, None)
    say(m["chat"]["id"], "Got it, thank you! 🙏\n\nWe're checking your payment now. "
                         "As soon as it's confirmed, I'll send your EA right here. "
                         "You can tap 📦 My order any time to check.")
    if not ADMIN:
        print(f"[warn] order {oid} sent proof but admin_chat_id is not set", file=sys.stderr)
        return
    who = f"@{order['username']}" if order["username"] else e(order["name"])
    api("copyMessage", chat_id=ADMIN, from_chat_id=m["chat"]["id"], message_id=m["message_id"])
    say(ADMIN, f"💰 <b>New payment to check</b>\nOrder: <code>{oid}</code>\n"
               f"Buyer: {who}\nPlan: {e(order['plan'])} ({e(order['price'])})\n"
               f"MT5 account: <code>{order['account']}</code>",
        [[btn("✅ Approve", f"approve:{oid}"), btn("❌ Reject", f"reject:{oid}")]], typing=False)


def relay_to_admin(m, user, intro):
    """Pass a buyer's message to you. Reply to it in Telegram and the bot sends your reply back."""
    if not ADMIN:
        say(m["chat"]["id"], f"Please message {e(CFG['support_username'])} and "
                             "they'll help you directly.")
        return
    who = f"@{user['username']}" if user.get("username") else e(user.get("first_name", ""))
    head = api("sendMessage", chat_id=ADMIN, parse_mode="HTML",
               text=f"💬 <b>{intro}</b> from {who}\n<i>Reply to the next message to answer them.</i>")
    copied = api("copyMessage", chat_id=ADMIN, from_chat_id=m["chat"]["id"],
                 message_id=m["message_id"])
    for msg in (head, copied):
        if msg and "message_id" in msg:
            DATA["relay"][str(msg["message_id"])] = user["id"]
    save_data()


# ================================================================ handlers

def remember_user(u):
    uid = str(u["id"])
    if uid not in DATA["users"]:
        DATA["users"][uid] = {"name": u.get("first_name", ""),
                              "username": u.get("username", ""), "joined": now_str()}
        save_data()
        return True
    return False


def handle_callback(cq):
    data = cq.get("data", "")
    chat_id = cq["message"]["chat"]["id"]
    mid = cq["message"]["message_id"]
    user = cq["from"]
    uid = user["id"]
    api("answerCallbackQuery", callback_query_id=cq["id"])

    if data == "exp:new":
        explain_for_beginner(chat_id)
    elif data == "exp:pro":
        explain_for_pro(chat_id)
    elif data == "results":
        show_results(chat_id)
    elif data == "prices":
        show_prices(chat_id)
    elif data == "setup":
        show_setup(chat_id)
    elif data == "buy":
        start_buy(chat_id, uid)
    elif data == "talk":
        start_talk(chat_id, uid)
    elif data.startswith("plan:"):
        plan = plan_by_id(data.split(":", 1)[1])
        if plan:
            ask_account(chat_id, uid, plan)
    elif data == "confirm" and STATE.get(uid, {}).get("step") == "confirm":
        ask_payment(chat_id, user)
    elif data.startswith(("approve:", "reject:")) and uid == ADMIN:
        action, oid = data.split(":", 1)
        admin_decide(chat_id, mid, oid, approve=(action == "approve"))


BUTTON_ACTIONS = {
    "🛒 buy": "buy", "💰 prices": "prices", "📊 results": "results",
    "❓ how it works": "how", "💬 talk to us": "talk", "📦 my order": "order",
}


def handle_message(m):
    chat_id = m["chat"]["id"]
    user = m.get("from", {})
    uid = user.get("id")
    text = (m.get("text") or "").strip()
    low = text.lower()
    has_file = bool(m.get("photo") or m.get("document"))
    is_new = remember_user(user)
    name = user.get("first_name", "")

    # ---------- you (the admin)
    if uid == ADMIN:
        if handle_admin(m, text):
            return
        reply_to = m.get("reply_to_message")
        if reply_to and str(reply_to["message_id"]) in DATA["relay"]:
            buyer = DATA["relay"][str(reply_to["message_id"])]
            say(buyer, "💬 <b>Message from our team:</b>", typing=False)
            api("copyMessage", chat_id=buyer, from_chat_id=chat_id, message_id=m["message_id"])
            say(chat_id, "✅ Sent to the buyer.", typing=False)
            return

    # ---------- commands
    if low.startswith("/start") or low.startswith("/menu"):
        STATE.pop(uid, None)
        welcome(chat_id, name)
        return
    if low.startswith("/myid"):
        say(chat_id, f"Your Telegram ID is <code>{uid}</code>", typing=False)
        return
    if low in ("/cancel", "cancel", "stop"):
        STATE.pop(uid, None)
        say(chat_id, "No worries, I've cancelled that. What else can I help with? 🙂")
        return

    # ---------- bottom buttons
    action = BUTTON_ACTIONS.get(low)
    if action:
        if action != "order":
            STATE.pop(uid, None)
        {"buy": lambda: start_buy(chat_id, uid),
         "prices": lambda: show_prices(chat_id),
         "results": lambda: show_results(chat_id),
         "how": lambda: show_how_it_works(chat_id),
         "talk": lambda: start_talk(chat_id, uid),
         "order": lambda: show_my_order(chat_id, uid)}[action]()
        return

    st = STATE.get(uid, {})
    step = st.get("step")

    # ---------- talking to the team
    if step == "talk":
        STATE.pop(uid, None)
        relay_to_admin(m, user, "Message")
        say(chat_id, "Thanks! I've sent that to our team 📨 They'll reply here soon.")
        return

    # ---------- buying: waiting for the MT5 account number
    if step == "account":
        acct = text.replace(" ", "")
        if acct.isdigit() and 5 <= len(acct) <= 12:
            confirm_account(chat_id, uid, acct)
            return
        if answer_question(chat_id, text, name, mid_purchase=True):
            say(chat_id, "Whenever you're ready, just type your MT5 account number "
                         "to continue 🙂 (or type <i>cancel</i>)")
            return
        say(chat_id, "Hmm, that doesn't look like an MT5 account number 🤔\n"
                     "It's usually 6 to 10 digits, like <code>51234567</code>. "
                     "Please send numbers only.")
        return

    # ---------- buying: waiting for the payment receipt
    if step == "proof" or (has_file and latest_order(uid)[1]
                           and latest_order(uid)[1]["status"] == "awaiting_payment"):
        oid = st.get("order_id") or latest_order(uid)[0]
        if has_file or len(text) >= 20:  # screenshot, PDF, or a transaction hash
            receive_proof(m, uid, oid)
            return
        if answer_question(chat_id, text, name, mid_purchase=True):
            say(chat_id, "When you've paid, just send the receipt screenshot here 🙂")
            return
        say(chat_id, "Please send a <b>screenshot of your payment receipt</b> "
                     "(or the USDT transaction hash) so we can confirm it.")
        return

    # ---------- free chat
    if is_new and not text.startswith("/"):
        welcome(chat_id, name)
        return
    if text and answer_question(chat_id, text, name):
        return
    if has_file or text:
        relay_to_admin(m, user, "Question")
        say(chat_id, "Good question! I'm not 100% sure on that one, so I've passed it "
                     "to our team 📨 They'll reply right here soon.\n\n"
                     "Meanwhile, you can tap the buttons below to look around.")


def answer_question(chat_id, text, name, mid_purchase=False):
    """Try to answer something the person typed. Returns True if we understood it."""
    if not text:
        return False
    if matches(text, ["hi", "hello", "hey", "good morning", "good afternoon",
                      "good evening", "hiya", "howdy"]) and len(text) < 25:
        say(chat_id, f"Hi {e(name)}! 😊 What would you like to know about "
                     f"{e(P['name'])}? You can ask me anything.")
        return True
    if matches(text, ["thanks", "thank you", "thx", "appreciate"]):
        say(chat_id, "You're welcome! 🙌 I'm here if you need anything else.")
        return True
    if matches(text, ["buy", "purchase", "i want it", "order now", "get it", "sign up"]):
        start_buy(chat_id, chat_id)  # in private chats, chat id == user id
        return True
    if matches(text, ["human", "agent", "real person", "admin", "talk to", "speak to", "contact"]):
        start_talk(chat_id, chat_id)
        return True
    for r in CFG["smart_replies"]:
        if matches(text, r["keywords"]):
            say(chat_id, fill(r["answer"], name), None if mid_purchase else NEXT_STEP)
            return True
    return False


def admin_decide(chat_id, mid, oid, approve):
    order = DATA["orders"].get(oid)
    if not order:
        say(chat_id, f"Order {oid} not found.", typing=False)
        return
    if order["status"] in ("approved", "rejected"):
        say(chat_id, f"Order {oid} was already {order['status']}.", typing=False)
        return
    buyer = order["user_id"]

    if approve:
        if not DATA["ea_file_id"]:
            say(chat_id, "⚠️ No EA file set yet. Send the .ex5 file to me with the "
                         "caption /setfile, then tap Approve again.", typing=False)
            return
        order["status"] = "approved"
        order["decided"] = now_str()
        DATA["licenses"].append({"order_id": oid, "user_id": buyer,
                                 "account": order["account"], "plan": order["plan"],
                                 "date": now_str()})
        save_data()
        say(buyer, f"🎉 <b>Payment confirmed!</b> Thank you for your order "
                   f"(<code>{oid}</code>).\n\nHere's your copy of {e(P['name'])}, "
                   f"linked to MT5 account <code>{order['account']}</code> 👇")
        api("sendDocument", chat_id=buyer, document=DATA["ea_file_id"])
        say(buyer, f"<b>🛠 How to set it up</b>\n\n{e(CFG['setup_guide'])}\n\n"
                   "Stuck on any step? Tap 💬 Talk to us and we'll walk you through it.\n\n"
                   f"<i>{e(CFG['disclaimer'])}</i>")
        edit(chat_id, mid, f"✅ Order <code>{oid}</code> approved. EA delivered.")
    else:
        order["status"] = "rejected"
        order["decided"] = now_str()
        save_data()
        say(buyer, f"Sorry, we couldn't confirm the payment for order <code>{oid}</code> 😕\n\n"
                   "Please tap 💬 Talk to us and send your receipt, and we'll sort it out.")
        edit(chat_id, mid, f"❌ Order <code>{oid}</code> rejected. Buyer has been told.")


def handle_admin(m, text):
    """Your commands. Returns True if the message was one of them."""
    chat_id = m["chat"]["id"]
    caption = (m.get("caption") or "").strip()

    if caption.startswith("/setfile") and m.get("document"):
        DATA["ea_file_id"] = m["document"]["file_id"]
        save_data()
        say(chat_id, f"✅ EA file saved: {e(m['document'].get('file_name', ''))}. "
                     "Buyers get this file when you approve their order.", typing=False)
        return True

    if text.startswith("/stats"):
        o = list(DATA["orders"].values())
        count = lambda s: sum(1 for x in o if x["status"] == s)
        say(chat_id, f"📊 <b>Stats</b>\nPeople who started the bot: {len(DATA['users'])}\n"
                     f"Waiting for payment: {count('awaiting_payment')}\n"
                     f"Receipts to check: {count('pending_review')}\n"
                     f"Sold: {count('approved')}\nRejected: {count('rejected')}\n"
                     f"EA file uploaded: {'yes' if DATA['ea_file_id'] else 'no'}",
            typing=False)
        return True

    if text.startswith("/pending"):
        rows = [(oid, x) for oid, x in DATA["orders"].items() if x["status"] == "pending_review"]
        if not rows:
            say(chat_id, "No receipts waiting to be checked.", typing=False)
        for oid, x in rows:
            say(chat_id, f"<code>{oid}</code>: {e(x['plan'])} {e(x['price'])}, "
                         f"account <code>{x['account']}</code>",
                [[btn("✅ Approve", f"approve:{oid}"), btn("❌ Reject", f"reject:{oid}")]],
                typing=False)
        return True

    if text.startswith("/licenses"):
        if not DATA["licenses"]:
            say(chat_id, "No licenses yet.", typing=False)
        else:
            lines = [f"{l['account']}  ({l['plan']}, {l['date'][:10]}, {l['order_id']})"
                     for l in DATA["licenses"]]
            say(chat_id, "<b>Licensed MT5 accounts</b>\n<code>" + e("\n".join(lines)) +
                "</code>", typing=False)
        return True

    if text.startswith("/broadcast"):
        msg = text[len("/broadcast"):].strip()
        if not msg:
            say(chat_id, "Usage: /broadcast your message here", typing=False)
            return True
        sent = 0
        for u in list(DATA["users"]):
            if say(int(u), e(msg), [[btn("🛒 Buy now", "buy")]], typing=False):
                sent += 1
            time.sleep(0.05)  # stay under Telegram's rate limit
        say(chat_id, f"📣 Sent to {sent} of {len(DATA['users'])} people.", typing=False)
        return True

    if text.startswith("/adminhelp"):
        say(chat_id,
            "<b>Admin commands</b>\n"
            "/setfile: send the .ex5 file with this as the caption\n"
            "/pending: receipts waiting for you\n"
            "/stats: people and orders\n"
            "/licenses: licensed MT5 account numbers\n"
            "/broadcast &lt;text&gt;: message everyone who started the bot\n\n"
            "💬 To answer a buyer's question, just <b>reply</b> to their message "
            "and the bot will forward your reply to them.", typing=False)
        return True

    return False


# ================================================================ reminders

def send_payment_reminders():
    hours = CFG.get("payment_reminder_hours") or 0
    if not hours:
        return
    cutoff = now_ts() - int(hours * 3600)
    for oid, o in DATA["orders"].items():
        if o["status"] == "awaiting_payment" and not o.get("reminded") \
                and o.get("created_ts", now_ts()) < cutoff:
            o["reminded"] = True
            save_data()
            say(o["user_id"],
                f"Hi {e(o['name'])} 👋 Just checking in on your order "
                f"<code>{oid}</code>.\n\nIf you've already paid, send the receipt "
                "screenshot here and I'll get your EA to you. If something's holding "
                "you back, I'm happy to help 🙂",
                [[btn("💬 I have a question", "talk")]], typing=False)


# ================================================================ main loop

def main():
    if "PASTE_YOUR" in CFG["bot_token"]:
        sys.exit("Put your bot token from @BotFather into config.json first.")
    me = api("getMe")
    if not me:
        sys.exit("Could not connect - check the bot token and your internet.")
    print(f"Running as @{me['username']}. Press Ctrl+C to stop.")
    if not ADMIN:
        print("Note: admin_chat_id is 0. Send /myid to the bot, put that number in "
              "config.json, then restart.")

    api("setMyCommands", commands=[
        {"command": "start", "description": "Start over"},
        {"command": "cancel", "description": "Cancel what you're doing"},
    ])

    while True:
        updates = api("getUpdates", offset=DATA["offset"], timeout=50,
                      allowed_updates=["message", "callback_query"])
        if updates is None:
            time.sleep(3)
            continue
        for u in updates:
            DATA["offset"] = u["update_id"] + 1
            try:
                if "callback_query" in u:
                    handle_callback(u["callback_query"])
                elif "message" in u and u["message"].get("chat", {}).get("type") == "private":
                    handle_message(u["message"])
            except Exception as ex:  # one bad message should never stop the bot
                print(f"[error] {ex!r}", file=sys.stderr)
        if updates:
            save_data()
        send_payment_reminders()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        save_data()
        print("\nStopped.")
